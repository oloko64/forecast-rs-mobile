<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The widget's clock opens the phone's clock app: these must be visible to us (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <package android:name="com.sec.android.app.clockpackage" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.android.deskclock" />
        <package android:name="com.oneplus.deskclock" />
        <package android:name="com.coloros.alarmclock" />
        <package android:name="com.oplus.alarmclock" />
        <package android:name="com.motorola.timeweatherwidget" />
        <package android:name="com.asus.deskclock" />
        <package android:name="com.sonymobile.alarm" />
    </queries>
    <!-- GPS (tauri-plugin-geolocation): precise location; Android 12+ requires COARSE alongside FINE. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.forecast_mobile"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen chart widget (com.oloko.forecast.widget). -->
        <receiver
            android:name=".widget.ForecastWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/forecast_widget_info" />
        </receiver>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
